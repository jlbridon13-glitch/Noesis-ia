<!-- ═══════════════════ SCRIPTS ═══════════════════ -->
<script>
/* ─── CURSOR ─── */
const dot=document.getElementById('c-dot'),ring=document.getElementById('c-ring');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px'});
(function animRing(){rx+=(mx-rx)*0.1;ry+=(my-ry)*0.1;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(animRing)})();
document.querySelectorAll('a,button,.t-switch,.calc-range,.faq-q,.sol-chip,.ba-row,.mod-card,.team-card,.temo-card,.roi-bar-card').forEach(el=>{
  el.addEventListener('mouseenter',()=>document.body.classList.add('cursor-hover'));
  el.addEventListener('mouseleave',()=>document.body.classList.remove('cursor-hover'));
});

/* ─── SCROLL BAR ─── */
window.addEventListener('scroll',()=>{
  const pct=(window.scrollY/(document.body.scrollHeight-window.innerHeight))*100;
  document.getElementById('scroll-bar').style.width=pct+'%';
  document.getElementById('nav').classList.toggle('scrolled',window.scrollY>60);
});

/* ─── THREE.JS BACKGROUND ─── */
(function(){
  const c=document.getElementById('three-canvas');
  const renderer=new THREE.WebGLRenderer({canvas:c,alpha:true,antialias:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  renderer.setSize(innerWidth,innerHeight);
  renderer.setClearColor(0x000000,0);
  const scene=new THREE.Scene();
  const camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,0.1,1000);
  camera.position.z=30;
  const geo=new THREE.BufferGeometry();
  const N=280;
  const pos=new Float32Array(N*3);
  const vel=[];
  for(let i=0;i<N;i++){
    pos[i*3]=(Math.random()-0.5)*80;
    pos[i*3+1]=(Math.random()-0.5)*60;
    pos[i*3+2]=(Math.random()-0.5)*40;
    vel.push({x:(Math.random()-0.5)*0.02,y:(Math.random()-0.5)*0.02,z:(Math.random()-0.5)*0.01});
  }
  geo.setAttribute('position',new THREE.BufferAttribute(pos,3));
  const mat=new THREE.PointsMaterial({color:0xB8973A,size:0.18,transparent:true,opacity:0.7});
  const pts=new THREE.Points(geo,mat);
  scene.add(pts);
  const lineMat=new THREE.LineBasicMaterial({color:0xB8973A,transparent:true,opacity:0.06});
  const lineGeo=new THREE.BufferGeometry();
  const linePos=[];
  for(let i=0;i<N;i++)for(let j=i+1;j<N;j++){
    const dx=pos[i*3]-pos[j*3],dy=pos[i*3+1]-pos[j*3+1],dz=pos[i*3+2]-pos[j*3+2];
    if(Math.sqrt(dx*dx+dy*dy+dz*dz)<12){
      linePos.push(pos[i*3],pos[i*3+1],pos[i*3+2],pos[j*3],pos[j*3+1],pos[j*3+2]);
    }
  }
  lineGeo.setAttribute('position',new THREE.BufferAttribute(new Float32Array(linePos),3));
  scene.add(new THREE.LineSegments(lineGeo,lineMat));
  window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
  let t=0;
  (function animate(){
    requestAnimationFrame(animate);
    t+=0.001;
    pts.rotation.y=t*0.15;pts.rotation.x=t*0.08;
    renderer.render(scene,camera);
  })();
})();

/* ─── TYPEWRITER ─── */
const tw_words=['travaille','automatise','optimise','propulse'];
let tw_wi=0,tw_ci=0,tw_del=false;
const twEl=document.getElementById('tw-text');
function typeLoop(){
  const word=tw_words[tw_wi];
  if(!tw_del){twEl.textContent=word.slice(0,tw_ci+1);tw_ci++;if(tw_ci===word.length){tw_del=true;setTimeout(typeLoop,2000);return}}
  else{twEl.textContent=word.slice(0,tw_ci-1);tw_ci--;if(tw_ci===0){tw_del=false;tw_wi=(tw_wi+1)%tw_words.length}}
  setTimeout(typeLoop,tw_del?55:110);
}
setTimeout(typeLoop,1800);
// Animate hero title words
setTimeout(()=>document.querySelector('.w1').style.animationPlayState='running',600);
setTimeout(()=>document.querySelector('.w3').style.animationPlayState='running',900);

/* ─── LOSS COUNTER ─── */
const lossEl=document.getElementById('lossVal');
const perSec=41620/365/24/3600;
const t0=Date.now();
(function tickLoss(){
  const secs=(Date.now()-t0)/1000;
  lossEl.textContent=( secs*perSec).toLocaleString('fr-FR',{minimumFractionDigits:4,maximumFractionDigits:4})+' €';
  requestAnimationFrame(tickLoss);
})();

/* ─── COUNTER STATS ─── */
function animCount(el){
  const target=+el.dataset.target,suffix=el.dataset.suffix||'';
  let start=null;
  (function step(ts){
    if(!start)start=ts;
    const p=Math.min((ts-start)/2200,1);
    const ease=1-Math.pow(1-p,4);
    const v=Math.round(ease*target);
    el.textContent=(v>=1000?v.toLocaleString('fr-FR'):v)+suffix;
    if(p<1)requestAnimationFrame(step);
  })(performance.now());
}
const cObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){document.querySelectorAll('.stat-num').forEach(animCount);cObs.disconnect()}})},{threshold:0.5});
const strip=document.querySelector('.stats-strip');if(strip)cObs.observe(strip);

/* ─── FADE IN ─── */
const fadeObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');fadeObs.unobserve(e.target)}})},{threshold:0.07});
document.querySelectorAll('.fade').forEach(el=>fadeObs.observe(el));

/* ─── ROI BARS ─── */
const bObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){document.querySelectorAll('.roi-bar-fill').forEach(b=>{setTimeout(()=>{b.style.width=b.dataset.w+'%'},300)});bObs.disconnect()}})},{threshold:0.2});
const rb=document.querySelector('.roi-bars');if(rb)bObs.observe(rb);

/* ─── TIMELINE BARS ─── */
const tlObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){document.querySelectorAll('.tl-prog-bar').forEach((b,i)=>{setTimeout(()=>{b.style.width=b.dataset.w+'%'},400+i*200)});tlObs.disconnect()}})},{threshold:0.1});
const tl=document.querySelector('.timeline');if(tl)tlObs.observe(tl);

/* ─── ROI CHART ─── */
Chart.defaults.color='#444';
const rCtx=document.getElementById('roiChart');
if(rCtx){
  const months=['M1','M2','M3','M4','M5','M6','M7','M8','M9','M10','M11','M12'];
  const monthly=41620/12;
  new Chart(rCtx,{
    type:'line',
    data:{labels:months,datasets:[
      {label:'Économies cumulées',data:months.map((_,i)=>Math.round(monthly*(i+1))),borderColor:'#B8973A',backgroundColor:'rgba(184,151,58,0.06)',borderWidth:2,pointBackgroundColor:'#B8973A',pointRadius:3,pointHoverRadius:7,fill:true,tension:0.45},
      {label:'Investissement Pack',data:months.map(()=>2990),borderColor:'rgba(255,255,255,0.1)',borderWidth:1,borderDash:[5,5],pointRadius:0,fill:false}
    ]},
    options:{responsive:true,plugins:{legend:{labels:{color:'#444',font:{family:'Poppins',size:10},boxWidth:12,padding:20}},tooltip:{backgroundColor:'rgba(8,8,8,0.95)',borderColor:'rgba(184,151,58,0.2)',borderWidth:1,titleColor:'#B8973A',bodyColor:'#888',callbacks:{label:c=>c.dataset.label+' : '+c.raw.toLocaleString('fr-FR')+'€'}}},scales:{x:{grid:{color:'rgba(184,151,58,0.04)'},ticks:{color:'#444',font:{family:'Poppins',size:10}}},y:{grid:{color:'rgba(184,151,58,0.04)'},ticks:{color:'#444',font:{family:'Poppins',size:10},callback:v=>v.toLocaleString('fr-FR')+'€'},beginAtZero:true}}}
  });
}

/* ─── CALCULATEUR ROI ─── */
function fmtEur(v){return Math.round(v).toLocaleString('fr-FR')+'€'}
function updateCalc(){
  const emp=+document.getElementById('r-emp').value;
  const ca=+document.getElementById('r-ca').value;
  const waste=+document.getElementById('r-waste').value;
  const admin=+document.getElementById('r-admin').value;
  document.getElementById('cv-emp').textContent=emp;
  document.getElementById('cv-ca').textContent=ca.toLocaleString('fr-FR')+' €';
  document.getElementById('cv-waste').textContent=waste+' %';
  document.getElementById('cv-admin').textContent=admin+' h';
  const wasteEco=ca*12*(waste/100)*0.30;
  const rhEco=emp*22*admin*0.6*0.4;
  const cmdEco=ca*12*0.04;
  const socialEco=ca*12*0.02;
  const total=wasteEco+rhEco+cmdEco+socialEco;
  document.getElementById('r-waste-val').textContent=fmtEur(wasteEco);
  document.getElementById('r-rh-val').textContent=fmtEur(rhEco);
  document.getElementById('r-cmd-val').textContent=fmtEur(cmdEco);
  document.getElementById('r-social-val').textContent=fmtEur(socialEco);
  document.getElementById('r-total').textContent=fmtEur(total);
  const invest=2990;
  const roiMonths=total>0?Math.max(1,Math.round((invest/total)*12)):0;
  document.getElementById('r-roi-badge').textContent='ROI en '+roiMonths+' mois';
}
updateCalc();

/* ─── TARIF TOGGLE ─── */
let isMonthly=false;
const prices_u=['1 490€','1 990€','2 990€'],prices_m=['149€','199€','299€'];
const periods_u=['HT — paiement unique','HT — paiement unique','HT — paiement unique'];
const periods_m=['/mois · sans engagement après 3 mois','/mois · sans engagement après 3 mois','/mois · sans engagement après 3 mois'];
function togglePayment(){
  isMonthly=!isMonthly;
  document.getElementById('t-sw').classList.toggle('on',isMonthly);
  document.getElementById('lbl-u').classList.toggle('on',!isMonthly);
  document.getElementById('lbl-m').classList.toggle('on',isMonthly);
  const prices=isMonthly?prices_m:prices_u,periods=isMonthly?periods_m:periods_u;
  [1,2,3].forEach(i=>{
    document.getElementById('tp'+i).innerHTML='<sup>à partir de </sup>'+prices[i-1];
    document.getElementById('tpp'+i).textContent=periods[i-1];
  });
}

/* ─── FAQ ─── */
function toggleFaq(el){const item=el.parentElement,isOpen=item.classList.contains('open');document.querySelectorAll('.faq-item.open').forEach(i=>i.classList.remove('open'));if(!isOpen)item.classList.add('open')}
</script>
</body>
</html>
