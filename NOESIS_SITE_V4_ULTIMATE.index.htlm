<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOESIS — L'IA qui travaille pour vous</title>
<meta name="description" content="NOESIS — Agence IA premium pour salons de beauté et restaurants. StudioBoost & Restaurant_OS. Installation 7 jours. Garantie 60 jours.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,700&family=Poppins:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
/* ════════════════════════════════════════════
   RESET & VARS
════════════════════════════════════════════ */
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --gold:#B8973A;--gold-l:#D4AF6A;--gold-d:#8A6F2A;--gold-p:rgba(184,151,58,0.08);
  --black:#050505;--dark:#0A0A0A;--dark2:#0f0f0f;--card:#111;--card2:#161616;--card3:#1a1a1a;
  --white:#FAFAFA;--grey:#555;--grey-m:#777;--grey-l:#aaa;--grey-ll:#ccc;
  --glow:0 0 40px rgba(184,151,58,0.15);
  --glow-strong:0 0 80px rgba(184,151,58,0.25);
}
html{scroll-behavior:smooth;font-size:16px}
body{background:var(--black);color:var(--white);font-family:'Poppins',sans-serif;overflow-x:hidden;cursor:none}

/* ════════════════════════════════════════════
   CURSOR PREMIUM
════════════════════════════════════════════ */
#c-dot{width:5px;height:5px;background:var(--gold);border-radius:50%;position:fixed;z-index:9999;pointer-events:none;transform:translate(-50%,-50%);transition:transform 0.1s,width 0.3s,height 0.3s,background 0.3s}
#c-ring{width:38px;height:38px;border:1px solid rgba(184,151,58,0.4);border-radius:50%;position:fixed;z-index:9998;pointer-events:none;transform:translate(-50%,-50%);transition:width 0.4s,height 0.4s,border-color 0.3s,opacity 0.3s}
body.cursor-hover #c-dot{width:12px;height:12px;background:var(--gold-l)}
body.cursor-hover #c-ring{width:56px;height:56px;border-color:var(--gold);opacity:0.8}

/* ════════════════════════════════════════════
   SCROLL PROGRESS
════════════════════════════════════════════ */
#scroll-bar{position:fixed;top:0;left:0;height:2px;background:linear-gradient(to right,var(--gold-d),var(--gold),var(--gold-l));z-index:200;width:0%;transition:width 0.1s;box-shadow:0 0 10px rgba(184,151,58,0.5)}

/* ════════════════════════════════════════════
   CANVAS 3D & NEURAL
════════════════════════════════════════════ */
#three-canvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:0.6}
#neural-canvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:0}
#noise{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:0.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");background-size:200px}

/* ════════════════════════════════════════════
   NAV
════════════════════════════════════════════ */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:22px 64px;display:flex;justify-content:space-between;align-items:center;transition:all 0.6s cubic-bezier(0.4,0,0.2,1)}
nav.scrolled{background:rgba(5,5,5,0.92);border-bottom:1px solid rgba(184,151,58,0.1);backdrop-filter:blur(32px);padding:16px 64px}
.nav-brand{display:flex;flex-direction:column}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:700;color:var(--gold);letter-spacing:7px;line-height:1;transition:letter-spacing 0.4s}
nav.scrolled .nav-logo{letter-spacing:5px}
.nav-sub{font-size:8px;color:var(--grey-m);letter-spacing:6px;text-transform:uppercase;margin-top:3px}
.nav-links{display:flex;gap:40px;align-items:center}
.nav-links a{color:var(--grey-m);text-decoration:none;font-size:10px;letter-spacing:3px;text-transform:uppercase;transition:color 0.3s;position:relative;padding:4px 0}
.nav-links a::after{content:'';position:absolute;bottom:0;left:50%;right:50%;height:1px;background:var(--gold);transition:left 0.3s,right 0.3s}
.nav-links a:hover{color:var(--gold)}
.nav-links a:hover::after{left:0;right:0}
.nav-cta{background:transparent;border:1px solid rgba(184,151,58,0.5);color:var(--gold);padding:11px 30px;font-size:10px;letter-spacing:3px;text-transform:uppercase;cursor:none;transition:all 0.4s;font-family:'Poppins',sans-serif;position:relative;overflow:hidden}
.nav-cta::before{content:'';position:absolute;inset:0;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform 0.4s cubic-bezier(0.4,0,0.2,1)}
.nav-cta:hover::before{transform:scaleX(1)}
.nav-cta span{position:relative;z-index:1;transition:color 0.4s}
.nav-cta:hover span{color:var(--black)}

/* ════════════════════════════════════════════
   HERO
════════════════════════════════════════════ */
.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:140px 64px 100px;text-align:center;z-index:2}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(184,151,58,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(184,151,58,0.025) 1px,transparent 1px);background-size:80px 80px;mask-image:radial-gradient(ellipse 80% 80% at center,black,transparent)}
.hero-vignette{position:absolute;inset:0;background:radial-gradient(ellipse at center,transparent 40%,rgba(5,5,5,0.8) 100%)}
.hero-line-l{position:absolute;left:0;top:15%;bottom:15%;width:1px;background:linear-gradient(to bottom,transparent,var(--gold),transparent)}
.hero-line-r{position:absolute;right:0;top:25%;bottom:25%;width:1px;background:linear-gradient(to bottom,transparent,rgba(184,151,58,0.3),transparent)}
.hero-content{position:relative;z-index:3;max-width:1100px}
.hero-eyebrow{display:inline-flex;align-items:center;gap:16px;margin-bottom:44px;opacity:0;animation:heroFade 1s ease 0.4s forwards}
.hero-eyebrow-line{width:40px;height:1px;background:var(--gold)}
.hero-eyebrow span{font-size:10px;letter-spacing:7px;text-transform:uppercase;color:var(--gold)}
.hero-title{font-family:'Cormorant Garamond',serif;font-size:clamp(64px,11vw,160px);font-weight:300;line-height:0.83;margin-bottom:0;overflow:hidden}
.hero-title .word{display:inline-block;opacity:0;transform:translateY(100%);animation:wordReveal 0.9s cubic-bezier(0.16,1,0.3,1) forwards}
.hero-title .w1{animation-delay:0.6s}
.hero-title .w2{animation-delay:0.75s;color:var(--gold);font-style:italic;font-weight:700}
.hero-title .w3{animation-delay:0.9s}
@keyframes wordReveal{to{opacity:1;transform:translateY(0)}}
@keyframes heroFade{to{opacity:1;transform:translateY(0)}from{opacity:0;transform:translateY(12px)}}
.hero-tw-line{display:block;font-size:clamp(64px,11vw,160px);font-family:'Cormorant Garamond',serif;font-weight:300;min-height:1.1em;line-height:0.83}
#tw-text{color:var(--gold);font-style:italic;font-weight:700}
#tw-cursor{display:inline-block;width:4px;background:var(--gold);height:0.75em;vertical-align:middle;margin-left:2px;animation:blink 1s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
.hero-div{width:1px;height:60px;background:linear-gradient(to bottom,var(--gold),transparent);margin:44px auto;opacity:0;animation:heroFade 1s ease 1.2s forwards}
.hero-sub{font-size:clamp(15px,1.8vw,20px);color:var(--grey-l);font-weight:300;line-height:1.8;max-width:560px;margin:0 auto 52px;opacity:0;animation:heroFade 1s ease 1.4s forwards}
.hero-actions{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin-bottom:90px;opacity:0;animation:heroFade 1s ease 1.6s forwards}

/* BUTTONS */
.btn-primary{display:inline-block;background:var(--gold);color:var(--black);padding:18px 56px;font-size:11px;letter-spacing:4px;text-transform:uppercase;border:none;cursor:none;font-family:'Poppins',sans-serif;font-weight:700;transition:all 0.4s;text-decoration:none;position:relative;overflow:hidden}
.btn-primary::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,255,255,0.15) 50%,transparent 60%);transform:translateX(-150%);transition:transform 0.6s}
.btn-primary:hover{transform:translateY(-4px);box-shadow:0 24px 60px rgba(184,151,58,0.35)}
.btn-primary:hover::after{transform:translateX(150%)}
.btn-secondary{display:inline-block;background:transparent;color:var(--gold);padding:18px 56px;font-size:11px;letter-spacing:4px;text-transform:uppercase;border:1px solid rgba(184,151,58,0.35);cursor:none;font-family:'Poppins',sans-serif;transition:all 0.4s;text-decoration:none}
.btn-secondary:hover{border-color:var(--gold);background:rgba(184,151,58,0.05);transform:translateY(-4px)}

/* LOSS COUNTER HERO */
.loss-widget{opacity:0;animation:heroFade 1s ease 1.8s forwards;display:inline-block}
.loss-inner{border:1px solid rgba(184,151,58,0.2);padding:28px 48px;background:rgba(5,5,5,0.6);backdrop-filter:blur(20px);position:relative;overflow:hidden}
.loss-inner::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(184,151,58,0.03),transparent);pointer-events:none}
.loss-lbl{font-size:9px;letter-spacing:6px;text-transform:uppercase;color:var(--grey-m);margin-bottom:12px}
.loss-val{font-family:'Cormorant Garamond',serif;font-size:clamp(40px,6vw,72px);font-weight:700;color:var(--gold);line-height:1;font-variant-numeric:tabular-nums}
.loss-sublbl{font-size:10px;color:var(--grey);margin-top:8px;letter-spacing:1px}
.loss-pulse{position:absolute;top:16px;right:16px;width:8px;height:8px;border-radius:50%;background:var(--gold);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(184,151,58,0.6)}50%{box-shadow:0 0 0 10px rgba(184,151,58,0)}}

/* SCROLL HINT */
.scroll-hint{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:heroFade 1s ease 2.2s forwards;z-index:3}
.scroll-hint span{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:var(--grey)}
.scroll-arrow{width:1px;height:50px;background:linear-gradient(to bottom,var(--gold),transparent);animation:scrollDrop 2s ease-in-out infinite}
@keyframes scrollDrop{0%,100%{transform:scaleY(0.3);opacity:0}50%{transform:scaleY(1);opacity:1}}

/* ════════════════════════════════════════════
   SECTIONS
════════════════════════════════════════════ */
section{padding:120px 64px;position:relative;z-index:2}
.s-tag{font-size:9px;letter-spacing:7px;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
.s-title{font-family:'Cormorant Garamond',serif;font-size:clamp(38px,5.5vw,72px);font-weight:300;line-height:1.02;margin-bottom:18px}
.s-title strong{color:var(--gold);font-weight:700}
.s-sub{font-size:14px;color:var(--grey-m);line-height:1.9;max-width:540px}
.gold-line{width:1px;height:60px;background:linear-gradient(to bottom,var(--gold),transparent);margin:32px 0}
.gold-line-c{width:1px;height:60px;background:linear-gradient(to bottom,var(--gold),transparent);margin:32px auto}
.section-divider{height:1px;background:linear-gradient(to right,transparent,rgba(184,151,58,0.15),transparent);position:relative;z-index:2}

/* ════════════════════════════════════════════
   STATS FLOATING
════════════════════════════════════════════ */
.stats-strip{background:rgba(184,151,58,0.04);border-top:1px solid rgba(184,151,58,0.1);border-bottom:1px solid rgba(184,151,58,0.1);padding:0;display:flex;z-index:2;position:relative}
.stat-item{flex:1;padding:32px 24px;text-align:center;border-right:1px solid rgba(184,151,58,0.1);position:relative;overflow:hidden;transition:background 0.4s}
.stat-item:hover{background:rgba(184,151,58,0.04)}
.stat-item:last-child{border-right:none}
.stat-num{font-family:'Cormorant Garamond',serif;font-size:clamp(32px,3.5vw,52px);font-weight:700;color:var(--gold);line-height:1}
.stat-lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--grey-m);margin-top:8px}

/* ════════════════════════════════════════════
   BEFORE / AFTER
════════════════════════════════════════════ */
.ba-sec{background:var(--dark)}
.ba-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-top:72px}
.ba-col{padding:56px;position:relative;overflow:hidden}
.ba-before-col{background:var(--card)}
.ba-after-col{background:var(--card2);border:1px solid rgba(184,151,58,0.12)}
.ba-after-col::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,transparent,var(--gold),transparent)}
.ba-head{display:inline-flex;align-items:center;gap:12px;margin-bottom:36px}
.ba-head-dot{width:8px;height:8px;border-radius:50%}
.ba-before-col .ba-head-dot{background:var(--grey)}
.ba-after-col .ba-head-dot{background:var(--gold);box-shadow:0 0 12px var(--gold)}
.ba-head-label{font-size:9px;letter-spacing:5px;text-transform:uppercase}
.ba-before-col .ba-head-label{color:var(--grey-m)}
.ba-after-col .ba-head-label{color:var(--gold)}
.ba-row{display:flex;align-items:flex-start;gap:18px;margin-bottom:26px;transition:transform 0.3s}
.ba-row:hover{transform:translateX(6px)}
.ba-ico{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:16px;margin-top:1px}
.ba-before-col .ba-ico{background:rgba(180,60,60,0.08);color:rgba(220,80,80,0.7)}
.ba-after-col .ba-ico{background:rgba(184,151,58,0.12);color:var(--gold)}
.ba-row-text{font-size:14px;line-height:1.65}
.ba-before-col .ba-row-text{color:var(--grey-m)}
.ba-after-col .ba-row-text{color:var(--grey-ll)}

/* ════════════════════════════════════════════
   SOLUTIONS
════════════════════════════════════════════ */
.sol-sec{background:var(--black)}
.sol-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-top:72px}
.sol-card{background:var(--card);padding:64px;position:relative;overflow:hidden;transition:all 0.6s cubic-bezier(0.4,0,0.2,1)}
.sol-card:hover{background:var(--card2)}
.sol-card-shine{position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(105deg,transparent,rgba(184,151,58,0.03),transparent);transition:left 0.8s}
.sol-card:hover .sol-card-shine{left:150%}
.sol-glyph{font-family:'Cormorant Garamond',serif;font-size:160px;font-weight:700;color:rgba(184,151,58,0.03);position:absolute;right:-20px;top:-20px;line-height:1;pointer-events:none;transition:all 0.6s}
.sol-card:hover .sol-glyph{color:rgba(184,151,58,0.06);transform:scale(1.05) rotate(-3deg)}
.sol-top-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,var(--gold),var(--gold-l));transform:scaleX(0);transform-origin:left;transition:transform 0.7s cubic-bezier(0.4,0,0.2,1)}
.sol-card:hover .sol-top-line{transform:scaleX(1)}
.sol-eyebrow{font-size:9px;letter-spacing:6px;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
.sol-name{font-family:'Cormorant Garamond',serif;font-size:clamp(48px,5vw,72px);font-weight:700;color:var(--white);margin-bottom:18px;line-height:0.95}
.sol-desc{font-size:13px;color:var(--grey-m);line-height:1.9;margin-bottom:32px}
.sol-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px}
.sol-chip{font-size:9px;letter-spacing:2px;padding:6px 14px;border:1px solid rgba(184,151,58,0.15);color:var(--gold-l);text-transform:uppercase;transition:all 0.3s;cursor:none}
.sol-chip:hover{border-color:var(--gold);background:rgba(184,151,58,0.06);transform:translateY(-2px)}
.sol-price-row{border-top:1px solid rgba(184,151,58,0.1);padding-top:28px;margin-top:8px}
.sol-price{font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:700;color:var(--gold);line-height:1}
.sol-price-sub{font-size:11px;color:var(--grey-m);margin-top:6px;letter-spacing:1px}

/* ════════════════════════════════════════════
   TARIFS INTERACTIFS
════════════════════════════════════════════ */
.tarif-sec{background:var(--dark)}
.tarif-toggle-wrap{display:flex;align-items:center;gap:24px;margin-top:64px;margin-bottom:48px}
.t-label{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--grey-m);transition:color 0.3s}
.t-label.on{color:var(--gold)}
.t-switch{width:60px;height:30px;background:rgba(184,151,58,0.1);border:1px solid rgba(184,151,58,0.3);border-radius:15px;position:relative;cursor:none;transition:background 0.3s}
.t-switch.on{background:rgba(184,151,58,0.25)}
.t-knob{width:22px;height:22px;background:var(--gold);border-radius:50%;position:absolute;top:3px;left:4px;transition:left 0.35s cubic-bezier(0.4,0,0.2,1);box-shadow:0 0 12px rgba(184,151,58,0.4)}
.t-switch.on .t-knob{left:34px}
.tarif-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
.t-card{background:var(--card);padding:48px 36px;position:relative;overflow:hidden;transition:all 0.4s;text-align:center}
.t-card:hover{background:var(--card2);transform:translateY(-6px);box-shadow:0 30px 80px rgba(0,0,0,0.4)}
.t-card.featured{background:rgba(184,151,58,0.04);outline:1px solid rgba(184,151,58,0.25);transform:translateY(-4px)}
.t-card.featured:hover{transform:translateY(-10px);box-shadow:var(--glow-strong)}
.t-ribbon{position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--gold);color:var(--black);font-size:8px;letter-spacing:4px;text-transform:uppercase;padding:6px 22px;font-weight:700;white-space:nowrap}
.t-name{font-size:9px;letter-spacing:6px;text-transform:uppercase;color:var(--gold);margin-bottom:16px;margin-top:10px}
.t-price-wrap{margin-bottom:8px}
.t-price{font-family:'Cormorant Garamond',serif;font-size:clamp(48px,5vw,72px);font-weight:700;color:var(--white);line-height:1;transition:all 0.4s}
.t-price sup{font-size:20px;vertical-align:super;color:var(--grey-m)}
.t-period{font-size:11px;color:var(--grey-m);letter-spacing:1px;min-height:18px}
.t-div{width:32px;height:1px;background:var(--gold);margin:24px auto}
.t-eco-num{font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:700;color:var(--gold)}
.t-eco-lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--grey-m);margin-bottom:28px}
.t-features{text-align:left;margin-bottom:28px;display:flex;flex-direction:column;gap:0}
.t-feat{font-size:12px;color:var(--grey-l);padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.04);display:flex;align-items:center;gap:12px}
.t-feat-dot{width:4px;height:4px;background:var(--gold);border-radius:50%;flex-shrink:0}
.t-roi{background:rgba(184,151,58,0.06);border:1px solid rgba(184,151,58,0.12);padding:16px;text-align:center;margin-top:8px}
.t-roi-num{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:700;color:var(--gold)}
.t-roi-lbl{font-size:9px;color:var(--grey-m);letter-spacing:2px;text-transform:uppercase;margin-top:4px}

/* ════════════════════════════════════════════
   ROI CALCULATOR
════════════════════════════════════════════ */
.calc-sec{background:var(--black)}
.calc-wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:3px;margin-top:72px}
.calc-inputs{background:var(--card);padding:56px}
.calc-output{background:var(--card2);padding:56px;border:1px solid rgba(184,151,58,0.12);position:relative;overflow:hidden}
.calc-output::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,transparent,var(--gold),transparent)}
.calc-input-group{margin-bottom:36px}
.calc-label{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.calc-value{font-family:'Cormorant Garamond',serif;font-size:22px;color:var(--white)}
.calc-range{width:100%;-webkit-appearance:none;appearance:none;height:2px;background:rgba(184,151,58,0.15);outline:none;border-radius:2px;cursor:none}
.calc-range::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--gold);cursor:none;border:2px solid var(--black);box-shadow:0 0 12px rgba(184,151,58,0.5);transition:transform 0.2s}
.calc-range::-webkit-slider-thumb:hover{transform:scale(1.3)}
.calc-divider{height:1px;background:rgba(184,151,58,0.08);margin:8px 0 28px}
.calc-output-title{font-size:9px;letter-spacing:6px;text-transform:uppercase;color:var(--gold);margin-bottom:36px}
.calc-result-row{display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid rgba(255,255,255,0.04)}
.calc-result-row:last-of-type{border-bottom:none}
.calc-result-label{font-size:12px;color:var(--grey-m)}
.calc-result-val{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:700;color:var(--gold);transition:all 0.4s}
.calc-total{background:rgba(184,151,58,0.06);border:1px solid rgba(184,151,58,0.2);padding:28px;margin-top:28px;text-align:center}
.calc-total-label{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:var(--grey-m);margin-bottom:12px}
.calc-total-num{font-family:'Cormorant Garamond',serif;font-size:clamp(40px,5vw,64px);font-weight:700;color:var(--gold);line-height:1;transition:all 0.5s}
.calc-total-sub{font-size:11px;color:var(--grey-m);margin-top:8px}
.calc-roi-badge{display:inline-block;background:rgba(184,151,58,0.15);color:var(--gold);font-size:11px;letter-spacing:2px;text-transform:uppercase;padding:6px 18px;margin-top:16px;transition:all 0.4s}

/* ════════════════════════════════════════════
   TIMELINE
════════════════════════════════════════════ */
.timeline-sec{background:var(--dark)}
.timeline{margin-top:72px;position:relative;max-width:800px}
.tl-spine{position:absolute;left:24px;top:12px;bottom:12px;width:1px;background:linear-gradient(to bottom,var(--gold) 0%,rgba(184,151,58,0.1) 100%)}
.tl-item{position:relative;padding-left:80px;margin-bottom:54px}
.tl-item:last-child{margin-bottom:0}
.tl-node{position:absolute;left:16px;top:8px;width:18px;height:18px;border:1px solid var(--gold);border-radius:50%;background:var(--dark);display:flex;align-items:center;justify-content:center;transition:all 0.4s}
.tl-node::after{content:'';width:6px;height:6px;background:var(--gold);border-radius:50%;transition:transform 0.3s}
.tl-item:hover .tl-node{box-shadow:0 0 20px rgba(184,151,58,0.4);background:rgba(184,151,58,0.08)}
.tl-item:hover .tl-node::after{transform:scale(1.5)}
.tl-day{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
.tl-title{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:700;color:var(--white);margin-bottom:10px;line-height:1.1}
.tl-desc{font-size:13px;color:var(--grey-m);line-height:1.85;max-width:560px}
.tl-prog-wrap{height:2px;background:rgba(184,151,58,0.08);margin-top:20px;max-width:480px;overflow:hidden}
.tl-prog-bar{height:100%;background:linear-gradient(to right,var(--gold-d),var(--gold));width:0;transition:width 1.8s cubic-bezier(0.4,0,0.2,1)}

/* ════════════════════════════════════════════
   ROI GRAPHIQUES
════════════════════════════════════════════ */
.roi-sec{background:var(--black)}
.roi-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:3px;margin-top:72px;align-items:start}
.roi-bars{display:flex;flex-direction:column;gap:3px}
.roi-bar-card{background:var(--card);padding:28px 32px;display:flex;align-items:center;gap:24px;transition:all 0.4s;position:relative;overflow:hidden;cursor:none}
.roi-bar-card:hover{background:var(--card2)}
.roi-bar-card.feat{background:rgba(184,151,58,0.04);outline:1px solid rgba(184,151,58,0.2)}
.roi-bar-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:0;background:rgba(184,151,58,0.04);transition:width 0.5s}
.roi-bar-card:hover::before{width:100%}
.roi-bar-info{min-width:200px;position:relative;z-index:1}
.roi-bar-num{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:700;color:var(--gold);line-height:1}
.roi-bar-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--grey-m);margin-top:4px}
.roi-bar-detail{font-size:11px;color:var(--grey-l);margin-top:6px}
.roi-bar-track{flex:1;height:2px;background:rgba(255,255,255,0.04);position:relative;overflow:hidden}
.roi-bar-fill{height:100%;background:linear-gradient(to right,var(--gold-d),var(--gold));width:0;transition:width 2s cubic-bezier(0.4,0,0.2,1)}
.chart-panel{background:var(--card);padding:44px;border:1px solid rgba(184,151,58,0.07);position:sticky;top:100px}
.chart-panel-title{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:var(--gold);margin-bottom:32px}

/* ════════════════════════════════════════════
   MODULES
════════════════════════════════════════════ */
.mod-sec{background:var(--dark)}
.mod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:72px;background:rgba(184,151,58,0.04)}
.mod-card{background:var(--dark);padding:48px 44px;transition:all 0.4s;position:relative;overflow:hidden}
.mod-card:hover{background:var(--card)}
.mod-card-line{position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,var(--gold),transparent);transform:scaleX(0);transition:transform 0.5s}
.mod-card:hover .mod-card-line{transform:scaleX(1)}
.mod-num{font-family:'Cormorant Garamond',serif;font-size:72px;font-weight:700;color:rgba(184,151,58,0.08);line-height:1;margin-bottom:8px;transition:color 0.4s}
.mod-card:hover .mod-num{color:rgba(184,151,58,0.18)}
.mod-title{font-size:11px;font-weight:700;color:var(--white);letter-spacing:4px;text-transform:uppercase;margin-bottom:14px}
.mod-desc{font-size:13px;color:var(--grey-m);line-height:1.85;margin-bottom:22px}
.mod-kpi{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:700;color:var(--gold)}
.mod-kpi-lbl{font-size:9px;color:var(--grey-m);letter-spacing:3px;text-transform:uppercase;margin-top:3px}

/* ════════════════════════════════════════════
   TEMOIGNAGES
════════════════════════════════════════════ */
.temo-sec{background:var(--black)}
.temo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-top:72px}
.temo-card{background:var(--card);padding:48px;position:relative;overflow:hidden;transition:all 0.4s}
.temo-card:hover{background:var(--card2);transform:translateY(-6px);box-shadow:0 24px 60px rgba(0,0,0,0.5)}
.temo-quote-mark{font-family:'Cormorant Garamond',serif;font-size:140px;color:rgba(184,151,58,0.06);position:absolute;top:-25px;left:22px;line-height:1;pointer-events:none;transition:color 0.4s}
.temo-card:hover .temo-quote-mark{color:rgba(184,151,58,0.1)}
.temo-stars{display:flex;gap:4px;margin-bottom:20px}
.temo-star{color:var(--gold);font-size:14px}
.temo-text{font-size:14px;color:var(--grey-l);line-height:1.85;margin-bottom:28px;font-style:italic;position:relative;z-index:1}
.temo-author{font-size:11px;font-weight:700;color:var(--white);letter-spacing:3px;text-transform:uppercase}
.temo-role{font-size:10px;color:var(--gold);margin-top:5px;letter-spacing:2px}

/* ════════════════════════════════════════════
   EQUIPE
════════════════════════════════════════════ */
.team-sec{background:var(--dark)}
.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-top:72px}
.team-card{background:var(--card);padding:56px 48px;position:relative;overflow:hidden;transition:all 0.5s}
.team-card:hover{background:var(--card2);transform:translateY(-8px);box-shadow:var(--glow)}
.team-card-bottom{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(to right,transparent,var(--gold),transparent)}
.team-glyph{font-family:'Cormorant Garamond',serif;font-size:160px;font-weight:700;color:rgba(184,151,58,0.025);position:absolute;right:-20px;bottom:-30px;line-height:1;pointer-events:none;transition:all 0.5s}
.team-card:hover .team-glyph{color:rgba(184,151,58,0.06);transform:scale(1.1)}
.team-role{font-size:9px;letter-spacing:6px;text-transform:uppercase;color:var(--gold);margin-bottom:16px}
.team-name{font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:700;color:var(--white);margin-bottom:16px;line-height:1}
.team-desc{font-size:13px;color:var(--grey-m);line-height:1.85;margin-bottom:26px}
.team-phone{font-size:14px;color:var(--gold-l);letter-spacing:2px;font-weight:500}

/* ════════════════════════════════════════════
   GARANTIE
════════════════════════════════════════════ */
.garantie-sec{background:var(--black);text-align:center;padding:150px 64px;position:relative;overflow:hidden}
.garantie-bg-num{position:absolute;font-family:'Cormorant Garamond',serif;font-size:min(700px,70vw);font-weight:700;color:rgba(184,151,58,0.018);top:50%;left:50%;transform:translate(-50%,-50%);line-height:1;pointer-events:none;user-select:none;white-space:nowrap;animation:gentlePulse 10s ease-in-out infinite}
@keyframes gentlePulse{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.03)}}
.garantie-inner{position:relative;z-index:2;max-width:760px;margin:0 auto}
.garantie-big{font-family:'Cormorant Garamond',serif;font-size:clamp(90px,16vw,180px);font-weight:700;color:var(--gold);line-height:0.9;margin:24px 0 32px;text-shadow:var(--glow-strong)}
.garantie-text{font-size:20px;color:var(--grey-l);line-height:1.8;margin-bottom:56px}
.garantie-bonus{display:flex;gap:3px;justify-content:center;margin-top:56px;flex-wrap:wrap}
.g-bonus{background:var(--card);padding:28px 40px;flex:1;min-width:190px;transition:all 0.4s;border:1px solid transparent}
.g-bonus:hover{background:var(--card2);border-color:rgba(184,151,58,0.15);transform:translateY(-4px)}
.g-bonus-tag{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
.g-bonus-val{font-size:15px;color:var(--grey-l)}

/* ════════════════════════════════════════════
   FAQ
════════════════════════════════════════════ */
.faq-sec{background:var(--dark)}
.faq-wrap{max-width:840px;margin:72px auto 0;display:flex;flex-direction:column;gap:2px}
.faq-item{background:var(--card);overflow:hidden}
.faq-q{padding:22px 36px;cursor:none;display:flex;justify-content:space-between;align-items:center;font-size:15px;font-weight:400;color:var(--grey-ll);transition:color 0.3s;user-select:none;gap:24px}
.faq-q:hover{color:var(--white)}
.faq-icon{font-size:20px;color:var(--gold);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);flex-shrink:0;width:28px;height:28px;border:1px solid rgba(184,151,58,0.3);display:flex;align-items:center;justify-content:center;font-size:16px}
.faq-a{max-height:0;overflow:hidden;transition:max-height 0.5s ease}
.faq-a p{padding:0 36px 28px;font-size:13px;color:var(--grey-m);line-height:1.9}
.faq-item.open .faq-icon{transform:rotate(45deg);background:rgba(184,151,58,0.08)}
.faq-item.open .faq-a{max-height:240px}
.faq-item.open{background:var(--card2)}

/* ════════════════════════════════════════════
   CTA FINAL
════════════════════════════════════════════ */
.cta-sec{background:var(--black);text-align:center;padding:150px 64px;position:relative;overflow:hidden}
.cta-glow{position:absolute;bottom:-200px;left:50%;transform:translateX(-50%);width:800px;height:400px;background:radial-gradient(ellipse,rgba(184,151,58,0.08),transparent 70%);pointer-events:none}
.cta-heading{font-family:'Cormorant Garamond',serif;font-size:clamp(52px,9vw,120px);font-weight:300;line-height:0.88;position:relative;z-index:1}
.cta-heading strong{color:var(--gold);font-weight:700}
.cta-sub{font-size:17px;color:var(--grey-m);margin:32px 0 60px;line-height:1.8;position:relative;z-index:1}
.cta-contacts{display:flex;gap:3px;justify-content:center;margin-top:60px;flex-wrap:wrap}
.cta-contact{background:var(--card);padding:28px 48px;flex:1;min-width:200px;transition:all 0.4s;position:relative;overflow:hidden}
.cta-contact::before{content:'';position:absolute;inset:0;background:rgba(184,151,58,0.04);transform:translateY(100%);transition:transform 0.4s}
.cta-contact:hover::before{transform:translateY(0)}
.cta-contact:hover{border-color:rgba(184,151,58,0.2)}
.cta-cl{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:var(--grey-m);margin-bottom:10px;position:relative;z-index:1}
.cta-cv{font-size:15px;color:var(--gold-l);position:relative;z-index:1}

/* ════════════════════════════════════════════
   FOOTER
════════════════════════════════════════════ */
footer{background:var(--dark);border-top:1px solid rgba(184,151,58,0.08);padding:40px 64px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;position:relative;z-index:2}
.f-brand .f-logo{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:700;color:var(--gold);letter-spacing:7px}
.f-brand .f-tag{font-size:8px;color:var(--grey);letter-spacing:6px;text-transform:uppercase;margin-top:4px}
.f-links{display:flex;gap:28px}
.f-links a{font-size:10px;color:var(--grey-m);text-decoration:none;letter-spacing:3px;text-transform:uppercase;transition:color 0.3s}
.f-links a:hover{color:var(--gold)}
.f-copy{font-size:10px;color:rgba(80,80,80,0.6)}

/* ════════════════════════════════════════════
   FADE IN
════════════════════════════════════════════ */
.fade{opacity:0;transform:translateY(36px);transition:opacity 1.1s cubic-bezier(0.4,0,0.2,1),transform 1.1s cubic-bezier(0.4,0,0.2,1)}
.fade.in{opacity:1;transform:translateY(0)}
.fd1{transition-delay:0.1s}.fd2{transition-delay:0.2s}.fd3{transition-delay:0.3s}.fd4{transition-delay:0.4s}

/* ════════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════════ */
@media(max-width:1024px){nav{padding:18px 32px}nav.scrolled{padding:14px 32px}section{padding:80px 32px}.sol-grid,.ba-grid,.calc-wrap,.roi-grid,.tarif-cards,.team-grid,.temo-grid,.mod-grid{grid-template-columns:1fr}.calc-inputs,.calc-output{padding:36px}}
@media(max-width:768px){.hero{padding:120px 24px 80px}.stats-strip{flex-wrap:wrap}.stat-item{min-width:50%;border-bottom:1px solid rgba(184,151,58,0.1)}section{padding:70px 24px}footer{padding:28px 24px;flex-direction:column;text-align:center}.f-links{justify-content:center}#three-canvas,#c-dot,#c-ring{display:none}}
</style>
</head>
<body>

<!-- INFRASTRUCTURE -->
<canvas id="three-canvas"></canvas>
<canvas id="neural-canvas"></canvas>
<div id="noise"></div>
<div id="scroll-bar"></div>
<div id="c-dot"></div>
<div id="c-ring"></div>

<!-- ═══════════════════ NAV ═══════════════════ -->
<nav id="nav">
  <div class="nav-brand">
    <div class="nav-logo">NOESIS</div>
    <div class="nav-sub">Step by Step</div>
  </div>
  <div class="nav-links">
    <a href="#avant-apres">Transformation</a>
    <a href="#solutions">Solutions</a>
    <a href="#calculateur">Calculateur</a>
    <a href="#tarifs">Tarifs</a>
    <a href="#roi">ROI</a>
    <a href="#equipe">Équipe</a>
    <a href="#garantie">Garantie</a>
  </div>
  <button class="nav-cta" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})"><span>Démo gratuite</span></button>
</nav>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="hero" id="accueil">
  <div class="hero-grid"></div>
  <div class="hero-vignette"></div>
  <div class="hero-line-l"></div>
  <div class="hero-line-r"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">
      <div class="hero-eyebrow-line"></div>
      <span>Agence IA · Valence · Auvergne-Rhône-Alpes</span>
      <div class="hero-eyebrow-line"></div>
    </div>
    <h1 class="hero-title">
      <span class="word w1">L'IA&nbsp;qui</span><br>
      <span class="hero-tw-line"><span id="tw-text"></span><span id="tw-cursor"></span></span><br>
      <span class="word w3">pour&nbsp;vous.</span>
    </h1>
    <div class="hero-div"></div>
    <p class="hero-sub">Automatisez votre salon ou votre restaurant. Clé en main. En 7 jours. Zéro technique de votre côté.</p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary">Démonstration gratuite</a>
      <a href="#calculateur" class="btn-secondary">Calculer mon ROI</a>
    </div>
    <div class="loss-widget">
      <div class="loss-inner">
        <div class="loss-pulse"></div>
        <div class="loss-lbl">Pertes évitables pendant que vous lisez ceci</div>
        <div class="loss-val" id="lossVal">0.0000 €</div>
        <div class="loss-sublbl">basé sur 41 620 € de coûts évitables par an · Restaurant_OS</div>
      </div>
    </div>
  </div>
  <div class="scroll-hint">
    <span>Défiler</span>
    <div class="scroll-arrow"></div>
  </div>
</section>

<!-- STATS STRIP -->
<div class="stats-strip">
  <div class="stat-item"><div class="stat-num" data-target="41620" data-suffix="€">0</div><div class="stat-lbl">économisés par an</div></div>
  <div class="stat-item"><div class="stat-num" data-target="7" data-suffix=" jours">0</div><div class="stat-lbl">installation clé en main</div></div>
  <div class="stat-item"><div class="stat-num" data-target="60" data-suffix=" jours">0</div><div class="stat-lbl">garantie satisfait</div></div>
  <div class="stat-item"><div class="stat-num" data-target="70" data-suffix="%">0</div><div class="stat-lbl">no-shows en moins</div></div>
  <div class="stat-item"><div class="stat-num" data-target="5" data-suffix="h">0</div><div class="stat-lbl">gagnées par semaine</div></div>
</div>
<div class="section-divider"></div>

<!-- ═══════════════════ AVANT / APRÈS ═══════════════════ -->
<section class="ba-sec" id="avant-apres">
  <div class="fade">
    <div class="s-tag">Transformation</div>
    <h2 class="s-title">Avant NOESIS.<br><strong>Après NOESIS.</strong></h2>
    <div class="gold-line"></div>
  </div>
  <div class="ba-grid fade">
    <div class="ba-col ba-before-col">
      <div class="ba-head"><div class="ba-head-dot"></div><span class="ba-head-label">Sans NOESIS</span></div>
      <div class="ba-row"><div class="ba-ico">✗</div><div class="ba-row-text">Réservations gérées au téléphone entre deux clients — 1h perdue par jour</div></div>
      <div class="ba-row"><div class="ba-ico">✗</div><div class="ba-row-text">3 à 5 no-shows par semaine = créneaux perdus sèchement, sans recours</div></div>
      <div class="ba-row"><div class="ba-ico">✗</div><div class="ba-row-text">Stocks saisis à la main — erreurs, oublis, gaspillage alimentaire inutile</div></div>
      <div class="ba-row"><div class="ba-ico">✗</div><div class="ba-row-text">Instagram à l'abandon ou 2h de créativité perdues chaque semaine</div></div>
      <div class="ba-row"><div class="ba-ico">✗</div><div class="ba-row-text">Planning équipe = casse-tête de 3h tous les dimanches soir</div></div>
      <div class="ba-row"><div class="ba-ico">✗</div><div class="ba-row-text">Aucune visibilité sur vos chiffres réels en temps réel</div></div>
    </div>
    <div class="ba-col ba-after-col">
      <div class="ba-head"><div class="ba-head-dot"></div><span class="ba-head-label">Avec NOESIS</span></div>
      <div class="ba-row"><div class="ba-ico">✓</div><div class="ba-row-text">Réservations automatiques 24h/24 — même à 3h du matin, même pendant vos soins</div></div>
      <div class="ba-row"><div class="ba-ico">✓</div><div class="ba-row-text">No-shows réduits de 70% dès le 1er mois — garantie contractuelle</div></div>
      <div class="ba-row"><div class="ba-ico">✓</div><div class="ba-row-text">Une photo suffit — stocks mis à jour, DLC alertées, commandes suggérées</div></div>
      <div class="ba-row"><div class="ba-ico">✓</div><div class="ba-row-text">10 posts Instagram générés et publiés chaque semaine par l'IA — zéro effort</div></div>
      <div class="ba-row"><div class="ba-ico">✓</div><div class="ba-row-text">Planning calculé automatiquement en 2 minutes, optimisé par l'IA</div></div>
      <div class="ba-row"><div class="ba-ico">✓</div><div class="ba-row-text">Dashboard complet sur votre téléphone — CA, remplissage, équipe, en direct</div></div>
    </div>
  </div>
</section>
<div class="section-divider"></div>

<!-- ═══════════════════ SOLUTIONS ═══════════════════ -->
<section class="sol-sec" id="solutions">
  <div class="fade">
    <div class="s-tag">Nos solutions</div>
    <h2 class="s-title">Deux offres.<br><strong>Un seul objectif.</strong></h2>
    <p class="s-sub">Vous libérer des tâches chronophages pour vous concentrer sur ce qui compte vraiment.</p>
    <div class="gold-line"></div>
  </div>
  <div class="sol-grid fade">
    <div class="sol-card">
      <div class="sol-top-line"></div>
      <div class="sol-card-shine"></div>
      <div class="sol-glyph">SB</div>
      <div class="sol-eyebrow">Salons de beauté &amp; coiffeurs</div>
      <div class="sol-name">Studio<br>Boost</div>
