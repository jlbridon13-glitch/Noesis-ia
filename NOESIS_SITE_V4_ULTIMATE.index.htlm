<section class="cta-sec" id="contact">
  <div class="cta-glow"></div>
  <div class="fade">
    <div class="s-tag">Commençons ensemble</div>
    <div class="cta-heading">Démonstration<br><strong>gratuite.</strong></div>
    <div class="gold-line-c"></div>
    <p class="cta-sub">15 minutes. Par téléphone. Sans engagement.<br>On vous montre exactement ce que l'IA fera pour vous.</p>
    <a href="https://sites.google.com/view/lien-en-bio-nom-cliente/demo" class="btn-primary" style="font-size:11px;padding:20px 72px">Réserver ma démonstration</a>
