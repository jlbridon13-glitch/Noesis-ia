      <div class="cta-contact"><div class="cta-cl">Email</div><div class="cta-cv">stepbystep.26000@gmail.com</div></div>
      <div class="cta-contact"><div class="cta-cl">Instagram</div><div class="cta-cv">@noesis_ia</div></div>
      <div class="cta-contact"><div class="cta-cl">Commercial · Alyssia</div><div class="cta-cv">06 29 25 69 04</div></div>
    </div>
  </div>
</section>

<!-- ═══════════════════ FOOTER ═══════════════════ -->
<footer>
  <div class="f-brand"><div class="f-logo">NOESIS</div><div class="f-tag">Step by Step · Valence · AURA</div></div>
